% ── Jendela kode ────────────────────────────────────────────
\newlength{\headerht}  \setlength{\headerht}{26pt}
\newlength{\gutterwd}  \setlength{\gutterwd}{28pt}

\newcommand{\codewindowoverlay}[1]{%
  \fill[ctpMantle] (frame.north west) rectangle ([yshift=-\headerht]frame.north east);
  \draw[ctpSurface, line width=0.4pt] ([yshift=-\headerht]frame.north west) -- ([yshift=-\headerht]frame.north east);
  \fill[ctpMaroon] ([xshift=14pt, yshift=-13pt]frame.north west) circle (3.5pt);
  \fill[ctpYellow] ([xshift=26pt, yshift=-13pt]frame.north west) circle (3.5pt);
  \fill[ctpGreen]  ([xshift=38pt, yshift=-13pt]frame.north west) circle (3.5pt);
  \node[anchor=west, font=\footnotesize\ttfamily\color{ctpOverlay}, xshift=52pt, yshift=-13pt] at (frame.north west) {#1};
  \fill[ctpMantle] ([yshift=-\headerht]frame.north west) rectangle ([xshift=\gutterwd]frame.south west);
  \draw[ctpSurface, line width=0.4pt] ([yshift=-\headerht, xshift=\gutterwd]frame.north west) -- ([xshift=\gutterwd]frame.south west);
}

\newcommand{\codewindowgutter}{%
  \fill[ctpMantle] (frame.north west) rectangle ([xshift=\gutterwd]frame.south west);
  \draw[ctpSurface, line width=0.4pt] ([xshift=\gutterwd]frame.north west) -- ([xshift=\gutterwd]frame.south west);
}

\newenvironment{codewindow}[1]{%
  \begin{tcolorbox}[
    colback=ctpBase, colframe=ctpSurface, arc=8pt,
    left=0pt, right=0pt, top=\headerht, bottom=0pt,
    boxsep=0pt, before skip=12pt, after skip=10pt,
    breakable, enhanced,
    overlay unbroken={\codewindowoverlay{#1}},
    overlay first={\codewindowoverlay{#1}},
    overlay middle={\codewindowgutter},
    overlay last={\codewindowgutter},
  ]
}{%
  \end{tcolorbox}
}

