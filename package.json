{
  "name": "multimodal-v2-hands-on",
  "version": "1.0.0",
  "private": true,
  "description": "Build pipeline for hands-on PDF documents (Vivliostyle)",
  "scripts": {
    "bake": "node vivliostyle/bake.js hands-on/mgg02-hands-on.html hands-on/mgg02-hands-on.html",
    "build:pdf": "vivliostyle build --style vivliostyle/print-formal.css",
    "build:pdf:preview": "vivliostyle preview --style vivliostyle/print-formal.css"
  },
  "devDependencies": {
    "@vivliostyle/cli": "^11.2.0"
  }
}
